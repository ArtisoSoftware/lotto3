# estadio-dc.com - Use index.html as default
DirectoryIndex index.html

RewriteEngine On

# Force HTTPS + WWW (canonical: https://www.estadio-dc.com)
RewriteCond %{HTTP_HOST} !^www\.estadio-dc\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.estadio-dc.com%{REQUEST_URI} [R=301,L]

# 3) If request is NOT an existing file/dir => go to /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ / [L]